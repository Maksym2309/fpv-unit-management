//   https://drive.google.com/drive/folders/<ЦЕЙ_РЯДОК>
// Порожньо — розділ каже «сховище не під'єднане».
const INFO_ROOT_ID = '';

// ── Медіа-проксі (Cloudflare Worker) ──────────────────────────
// Адреса Worker (https://wh-media.….workers.dev, без слеша в кінці) і
// той самий рядок, що в секреті TICKET_SECRET у Cloudflare.
// Обидва порожні — застосунок тихо працює повільним шляхом через
